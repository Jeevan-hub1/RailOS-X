# RailOS-X Dashboard — local environment example.
# Copy to `.env.local` and adjust to point at your running backend services.
# These are read by src/lib/api.ts at build/runtime (NEXT_PUBLIC_* are exposed
# to the browser).

# Kavach++ Advisory service
NEXT_PUBLIC_KAVACH_URL=http://localhost:8082

# MARL Scheduler service
NEXT_PUBLIC_MARL_URL=http://localhost:8081

# Authorization Gate service
NEXT_PUBLIC_GATE_URL=http://localhost:8087
